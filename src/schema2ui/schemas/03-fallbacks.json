{
  "type": "object",
  "title": "Fallback cases",
  "description": "Shows the JSON fallback path for arrays, oneOf/anyOf/allOf, and object editors.",
  "properties": {
    "stringArray": {
      "type": "array",
      "title": "String array",
      "description": "Array fields currently fall back to JSON editing.",
      "items": {
        "type": "string"
      }
    },
    "objectEditor": {
      "type": "object",
      "title": "Object editor",
      "description": "Object editor uses the JSON fallback.",
      "x-ui:widget": "editor",
      "properties": {
        "foo": {
          "type": "string",
          "title": "Foo"
        },
        "bar": {
          "type": "number",
          "title": "Bar"
        }
      }
    },
    "oneOfValue": {
      "title": "One of",
      "description": "oneOf is currently handled by JSON fallback.",
      "oneOf": [
        {
          "type": "object",
          "title": "S3 Object",
          "properties": {
            "bucket": {
              "type": "string"
            },
            "object": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "title": "Inline Value",
          "properties": {
            "json_value": {
              "type": "string",
              "x-ui:widget": "textarea"
            }
          }
        }
      ]
    },
    "anyOfValue": {
      "title": "Any of",
      "description": "anyOf is currently handled by JSON fallback.",
      "anyOf": [
        {
          "type": "object",
          "title": "Option A",
          "properties": {
            "a": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "title": "Option B",
          "properties": {
            "b": {
              "type": "number"
            }
          }
        }
      ]
    },
    "allOfValue": {
      "title": "All of",
      "description": "allOf is currently handled by JSON fallback.",
      "allOf": [
        {
          "type": "object",
          "title": "Left",
          "properties": {
            "left": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "title": "Right",
          "properties": {
            "right": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
